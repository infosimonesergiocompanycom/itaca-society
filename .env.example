# --- Obbligatorie in produzione -------------------------------------------

# Database PostgreSQL (es. Neon dal Marketplace di Vercel, Supabase, ecc.)
DATABASE_URL=postgres://utente:password@host/db?sslmode=require

# Chiave per firmare sessioni e QR delle tessere: almeno 32 caratteri casuali.
# Generala con:  openssl rand -base64 48
# ATTENZIONE: se la cambi, tutte le sessioni e i QR esistenti diventano non validi.
AUTH_SECRET=

# Email (separate da virgola) che ricevono il ruolo di amministratore:
# possono approvare le domande, registrare quote e controllare gli ingressi.
ADMIN_EMAILS=info@itacasociety.com,soci@itacasociety.com

# Indirizzo pubblico del sito (serve per i ritorni da Stripe)
SITE_URL=https://www.itacasociety.com

# --- Pagamenti ----------------------------------------------------------------

# Chiave segreta Stripe (sk_test_... per le prove, sk_live_... in produzione)
STRIPE_SECRET_KEY=

# Segreto del webhook Stripe (evento: checkout.session.completed)
# Endpoint: https://<dominio>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Quota associativa in centesimi (default 1000 = 10 €)
MEMBERSHIP_FEE_CENTS=1000

# Solo per prove locali, senza Stripe: abilita il pagamento simulato.
# Non attivarla mai sul sito pubblico.
# ALLOW_DEMO_PAYMENTS=true

# Connessioni massime al database (default 5; su hosting condiviso 2-3 sono sufficienti)
DB_POOL_MAX=3

# Email automatiche (domanda nuova alla segreteria, domanda accolta e tessera attiva al socio).
# Basta UNA delle due configurazioni; senza, le email non partono e il sito funziona comunque.
# A) Casella di posta Serverplan (es. soci@itacasociety.com):
# SMTP_HOST=mail.itacasociety.com
# SMTP_PORT=465
# SMTP_USER=soci@itacasociety.com
# SMTP_PASSWORD=          # inseriscila solo nelle variabili di Vercel
# B) Resend (resend.com):
# RESEND_API_KEY=
# Mittente e destinatari degli avvisi (facoltativi)
# MAIL_FROM=Itaca Society <soci@itacasociety.com>
# NOTIFY_EMAILS=info@itacasociety.com,soci@itacasociety.com   # se vuoto: ADMIN_EMAILS
